# Supabase（前端用 NEXT_PUBLIC_ 前缀；服务端密钥不要暴露给浏览器）
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 目标网页系统（CDP 自动化要填的站点）—— 仅本地/长驻 Node 服务需要，云端部署不需要
TARGET_SYSTEM_URL=https://example.com/login

# 可选：置为 1 可临时关闭自动录入接口（云端 serverless 环境会自动禁用，无需手动设置）
# AUTOMATE_DISABLED=1

# 可选：Cloudflare R2 / 域名相关
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
